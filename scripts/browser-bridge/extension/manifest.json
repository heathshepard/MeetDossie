{
  "manifest_version": 3,
  "name": "Cole Browser Bridge",
  "version": "1.0.0",
  "key": "",
  "description": "Lets Heath's live Claude Code session (jarvis-bridge / Cole) read and act inside a real, logged-in Chrome tab on demand. Off by default per tab -- arm it with the toolbar icon.",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cole Browser Bridge (click to arm/disarm on this tab)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
