#!/bin/sh
#
# Blocks a commit that would put a personal email address into a PUBLIC repo.
#
# Enable (once per clone):  git config core.hooksPath .githooks
# Bypass is deliberately NOT documented here. If the guard is wrong, fix the
# baseline at scripts/personal-data-baseline.json with a reason on the line.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping personal-data guard" >&2
  exit 0
fi

node "$(git rev-parse --show-toplevel)/scripts/check-no-personal-data.js" --staged || exit 1
