{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__claude_ai_Vercel__get_runtime_logs",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__get_logs",
      "mcp__claude_ai_Supabase__get_publishable_keys",
      "mcp__claude_ai_Vercel__list_deployments"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/precompact-handoff.js",
            "timeout": 120
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/postcompact-reanchor.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pretooluse-guard.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/postcompact-clear-reanchor.js",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/end-of-turn-rules.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
